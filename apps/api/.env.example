# ── SERVIDOR Y ENTORNO ────────────────────────────────────────────────────────
# Puerto en el que correrá la API
PORT=3000
# Entorno de ejecución: development, production, test
NODE_ENV=development

# ── BASE DE DATOS (TURSO / LIBSQL) ────────────────────────────────────────────
# URL de conexión a Turso. Ejemplo local: file:local.db
# Para producción: libsql://tu-db-nombre.turso.io
TURSO_DATABASE_URL=libsql://your-db-name.turso.io
# Token de autenticación obtenido desde el dashboard de Turso
TURSO_AUTH_TOKEN=your_turso_auth_token_here

# ── AUTENTICACIÓN (JWT) ──────────────────────────────────────────────────────
# Secreto para firmar los tokens JWT. Debe ser complejo y privado (mínimo 16 caracteres)
JWT_SECRET=tu_secreto_super_seguro_para_produccion
# Tiempo de expiración del token (ej: 1h, 7d)
JWT_EXPIRES_IN=7d

# ── CORREO ELECTRÓNICO (RESEND) ───────────────────────────────────────────────
# API Key de Resend (https://resend.com)
RESEND_API_KEY=re_your_api_key_here
# Correo electrónico verificado en Resend que aparecerá como remitente
RESEND_FROM_EMAIL=info@tudominio.com
# Correo administrativo que recibirá notificaciones internas
ADMIN_EMAIL=admin@tudominio.com

# ── ALMACENAMIENTO (SUPABASE STORAGE) ─────────────────────────────────────────
# URL de tu proyecto en Supabase (opcional si no se usa carga de archivos)
SUPABASE_URL=https://your-project-id.supabase.co
# Service Role Key para operaciones administrativas de storage (¡NO USAR ANON KEY!)
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
# Nombre del Bucket público donde se guardarán los archivos
SUPABASE_STORAGE_PUBLIC_BUCKET=public-docs

# ── INTEGRACIÓN FRONTEND ──────────────────────────────────────────────────────
# URL pública del frontend (necesaria para generar links en correos electrónicos)
APP_URL=http://localhost:5173

# ── CORS (SEGURIDAD) ──────────────────────────────────────────────────────────
# Lista de dominios permitidos separada por comas (sin barra final)
# Importante incluir dominios de producción y localhost en desarrollo
CORS_ORIGINS=http://localhost:5173,https://tu-app.vercel.app
